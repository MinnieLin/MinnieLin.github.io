@phdthesis{Lin2026AILearningPartner,
  author = {Lin, Qiyang},
  year = {2026},
  title = {Designing and Evaluating a Theory-Driven AI Learning Partner for Metacognitive Regulation and Transfer},
  journal = {ProQuest Dissertations and Theses},
  pages = {171},
  note = {Copyright - Database copyright ProQuest LLC; ProQuest does not claim copyright in the individual underlying works; Last updated - 2026-08-18},
  abstract = {The rapid growth of Generative AI (GenAI) has created new opportunities to support learners' metacognitive regulation and adaptive reasoning in complex, open-ended problems. Realizing this potential requires AI systems that do more than give answers. They must scaffold how learners plan, monitor, and evaluate their thinking under uncertainty. This dissertation designed, implemented, and evaluated a theory-driven AI learning partner intended to support undergraduates' metacognitive regulation and transfer-oriented reasoning in pandemic decision-making. The design integrated Cognitive Flexibility Theory (CFT; Spiro et al., 2019) as the rationale for case variation, multiple perspectives, and context-sensitive prompting; Zimmerman's (2000) self-regulated learning cycle as the temporal structure for organizing support; and Efklides's (2008) and Tarricone's (2011) models of metacognitive regulation as the process mechanism to be elicited and observed. The study used a mixed-methods, single-condition, multiple-case design. Five undergraduates completed four AI-supported learning sessions. Multimodal data sources were integrated to examine both the processes and outcomes of AI-supported learning, including concurrent think-aloud protocols, learner-AI chat logs, pre- and post-tests, and transfer tasks. Findings are reported descriptively to support within-person and cross-case interpretation. Three research questions guided the analysis: how CFT and SRL principles were operationalized in the design and enacted behavior of the AI partner (RQ1), how learners externalized metacognitive regulation during interaction (RQ2), and how learners' understanding and transfer-oriented reasoning developed across sessions (RQ3). Results show that the AI partner enacted theory-aligned scaffolding, but the dialogue emphasized SRL more strongly than CFT. Monitoring prompts were frequent, while cross-case linking was rare. Learners externalized sustained regulation but followed different trajectories. Transfer-oriented reasoning results show that one focal learner refined an already adaptive but broad frame toward more conditional decisions, while the other moved unevenly from reductive containment toward more context-sensitive coordination before reverting to avoidance under uncertainty. Together, the study contributes a theory-driven model for designing AI learning partners, an approach to operationalizing CFT through system prompts, and a multimodal method for observing regulation during human-AI interaction.},
  keywords = {AI learning partner; Decision-making; Generative AI; Metacognitive regulation; Self-regulated learning; Transfer of learning; Education; Higher education; Educational technology; Artificial intelligence; 0710:Educational technology; 0515:Education; 0745:Higher education; 0800:Artificial intelligence},
  isbn = {9798186169505},
  language = {English},
  url = {https://ezproxy.msu.edu/login?url=https://www.proquest.com/dissertations-theses/designing-evaluating-theory-driven-ai-learning/docview/3369637399/se-2},

  abbr = {Generative AI, Metacognition, Self-regulated Learning, Transfer},
  selected = {true}
}

@article{Lin2026PredictiveInteractive,
  author = {Lin, Qiyang and He, Jingwen and Xie, Kui},
  title = {Predictive and interactive roles of motivation and situational learning activities on emotional and cognitive engagement},
  journal = {British Journal of Educational Psychology},
  year = {2026},
  keywords = {emotion, experience sampling method, learning strategies, motivation, out-of-class learning, self-efficacy, situational engagement},
  doi = {10.1111/bjep.70099},
  url = {https://bpspsychub.onlinelibrary.wiley.com/doi/abs/10.1111/bjep.70099},
  abstract = {Emotions and cognitions are important factors of learning engagement. While extensive research focuses on in-class activity, there is a gap in understanding engagement in out-of-class study contexts, particularly the interplay between motivation and situational engagement. This study aimed to examine the relationship between students' motivation, situational engagement (emotions and learning strategies), and the context of out-of-class learning activities. The study involved 394 undergraduate students, with a mean age of 21.26 (SD = 4.34). Students came from diverse ethnic backgrounds and various academic disciplines. We used the Experience Sampling Method (ESM) to capture in-situ data. During scheduled study sessions, participants filled out brief surveys on their smartphones regarding their cognitive engagement, emotional states, and learning activities. Motivation influenced emotional and cognitive engagement across various learning activities. The positive association between self-efficacy, enjoyment, and hope was weakened during collaborative activities, and its protective role against anxiety was reduced during assessments. Students with higher utility value reported greater enjoyment during reading and multimedia learning but less enjoyment during preparation and planning. For cognitive engagement, high self-efficacy was associated with greater use of deep learning strategies during constructive and application-oriented activities. A reciprocal relationship emerged between emotions and cognition: positive emotions enhanced deep strategy use, which in turn promoted positive emotions and reduced negative ones. The findings highlight the importance of fostering positive emotional experiences and motivation in out-of-class learning contexts. Educational interventions that target these factors can enhance students' engagement, leading to better academic outcomes.},

  abbr = {Motivation, Self-regulated Learning, Situational Engagement, Quantitative},
  bibtex_show = {true},
  pdf = {https://drive.google.com/file/d/1dMKwJ2jfnOhomIG6fEuYcLiQzSYgjU9u/view?usp=drive_link},
  % selected = {true}
}


